# Used by GoReleaser dockers_v2 — copies prebuilt binaries from the build context.
# Context layout: linux/<arch>/tcp-wait  (see https://goreleaser.com/customization/package/dockers_v2/)
FROM alpine:3.24
RUN apk add --no-cache ca-certificates
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/tcp-wait /usr/local/bin/tcp-wait
ENTRYPOINT ["/usr/local/bin/tcp-wait"]
